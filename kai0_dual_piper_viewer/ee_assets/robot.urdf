  <!--
    RGB 相机静态 TF 链（D435/D435i，与 dual_carm_a3 同一套本体系约定）：
      相机本体 link：原点=背侧中心，Z=镜头朝前，X=壳体顶部，Y=壳体右侧。
      *_color_frame         xyz=(0,-0.0325,0.02505)  D435 2D 图纸 RGB 名义偏移
      *_color_optical_frame  rpy=(0,0,+pi/2)         本体系 -> ROS optical
  -->
  <link name="head_camera_color_frame"/>
  <joint name="head_camera_color_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 -0.0325 0.02505"/>
    <parent link="head_camera_link_frame"/>
    <child link="head_camera_color_frame"/>
  </joint>
  <link name="head_camera_color_optical_frame"/>
  <joint name="head_camera_color_optical_joint" type="fixed">
    <origin rpy="0 0 1.5707963267948966" xyz="0 0 0"/>
    <parent link="head_camera_color_frame"/>
    <child link="head_camera_color_optical_frame"/>
  </joint>

  <link name="left_wrist_camera_color_frame"/>
  <joint name="left_wrist_camera_color_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 -0.0325 0.02505"/>
    <parent link="left_wrist_camera_link"/>
    <child link="left_wrist_camera_color_frame"/>
  </joint>
  <link name="left_wrist_camera_color_optical_frame"/>
  <joint name="left_wrist_camera_color_optical_joint" type="fixed">
    <origin rpy="0 0 1.5707963267948966" xyz="0 0 0"/>
    <parent link="left_wrist_camera_color_frame"/>
    <child link="left_wrist_camera_color_optical_frame"/>
  </joint>

  <link name="right_wrist_camera_color_frame"/>
  <joint name="right_wrist_camera_color_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 -0.0325 0.02505"/>
    <parent link="right_wrist_camera_link"/>
    <child link="right_wrist_camera_color_frame"/>
  </joint>
  <link name="right_wrist_camera_color_optical_frame"/>
  <joint name="right_wrist_camera_color_optical_joint" type="fixed">
    <origin rpy="0 0 1.5707963267948966" xyz="0 0 0"/>
    <parent link="right_wrist_camera_color_frame"/>
    <child link="right_wrist_camera_color_optical_frame"/>
  </joint>

  <!-- TCP：位置=joint7 零位 link7 原点（gripper_base z=0.138；相对 link6 指尖 142.5mm）；朝向与 gripper_base 一致（Z 接近 / Y 开合） -->
  <link name="left_tcp"/>
  <joint name="left_tcp_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0.138"/>
    <parent link="left_gripper_base"/>
    <child link="left_tcp"/>
  </joint>
  <link name="right_tcp"/>
  <joint name="right_tcp_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0.138"/>
    <parent link="right_gripper_base"/>
    <child link="right_tcp"/>
  </joint>
</robot>
